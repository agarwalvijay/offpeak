# Dependencies
node_modules/
mobile/node_modules/

# Web build
dist/
dist-ssr/
*.local

# Expo (we run a bare workflow now — android/ is vendored, see below)
mobile/.expo/
mobile/dist/
mobile/web-build/
*.orig.*

# android/ is VENDORED (bare workflow) — the native widget lives there and is
# hand-maintained; we no longer run `expo prebuild`. Ignore only build output.
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/build/
mobile/android/.cxx/
mobile/android/local.properties
mobile/ios/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Env
.env
.env.*
!.env.example

# Legacy Flutter/Android build artifacts (kept on disk, never committed)
legacy/**/build/
legacy/**/.gradle/
legacy/**/.dart_tool/
legacy/**/.idea/
*.apk
*.aab
*.jks
*.keystore
