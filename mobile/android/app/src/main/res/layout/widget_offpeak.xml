<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Left: price + level -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD166"
            android:textStyle="bold"
            android:textSize="30sp"
            android:text="--¢" />

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD166"
            android:textStyle="bold"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>

    <!-- Middle: utility + zone -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#F3F6FC"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="OffPeak" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#CFE0F5"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>

    <!-- Right: avg / updated + refresh -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D6E4F5"
            android:textSize="11sp"
            android:text="" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:textColor="#A8C0E0"
                android:textSize="10sp"
                android:text="" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="#CFE0F5"
                android:textStyle="bold"
                android:textSize="16sp"
                android:text="⟳" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
