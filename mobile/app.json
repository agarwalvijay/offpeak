{
  "expo": {
    "name": "OffPeak",
    "slug": "offpeak",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "offpeak",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1220",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atsumilabs.offpeak",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.atsumilabs.offpeak",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ],
      "expo-background-task",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "OffPeakPrice",
              "label": "OffPeak Price",
              "description": "Current ComEd hourly price and level",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1220",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#0b1220",
            "image": "./assets/splash-icon.png",
            "imageWidth": 150
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
